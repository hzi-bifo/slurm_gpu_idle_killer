DRY_RUN=0
GPU_ACTIVITY_POLICY=zero
# poll every 10 mins
POLL_INTERVAL_S=600
# 36 subsequent failures => 6 h
IDLE_THRESHOLD_POLLS=36
REQUIRE_ALL_NODES_IDLE=1
DEBUG=1
SEND_MAIL=0
MAIL_TO=
MAIL_FROM=
# Email to the job owner - disabled unless USER_EMAIL_CMD is set (the username is appended as an argument)
USER_EMAIL_CMD=
#USER_EMAIL_CMD=/root/bin/getUserEmail.sh
USER_MAIL_SUBJECT=GPU job killed
USER_MAIL_BODY_FILE=/etc/slurm-gpu-idle-killer-user-mail.txt
# If set, user emails go ONLY to this address
USER_MAIL_TEST_ADDRESS=
