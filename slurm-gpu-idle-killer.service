[Unit]
Description=Slurm GPU idle job killer (controller-side)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/default/slurm-gpu-idle-killer

# Run as root only if needed (e.g., ssh to nodes or scancel requires it).
# If you can scancel as a specific Slurm admin/service account, use that instead.
User=root
Group=root

# Where your script lives
WorkingDirectory=/opt

# Use an absolute path to python + script
ExecStart=/bin/bash -lc 'eval "$(/root/miniforge3/bin/conda shell.bash hook)"; conda activate slurm; exec python /opt/slurm_gpu_idle_killer.py'

# Restart on failure
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
